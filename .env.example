# =============================================================================
# Geld-bot – Music Creator Hub · Environment-Vorlage
#
# WICHTIG: Diese Datei enthält NUR Platzhalter. Niemals echte Secrets, Keys,
# Tokens oder eine IBAN eintragen oder committen. Die echten Werte werden lokal
# in .env bzw. im Hosting-System als Secrets hinterlegt.
# =============================================================================

# --- Basis -------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORT@HOST:5432/DATENBANK?schema=public
APP_URL=http://localhost:3000
NODE_ENV=development

# --- Auth & Krypto (je mindestens 32 Zeichen) --------------------------------
# Erzeugen mit: openssl rand -base64 48
AUTH_SECRET=
NEXTAUTH_SECRET=
DOWNLOAD_SIGNING_SECRET=
CSRF_SECRET=

# --- Payment Provider --------------------------------------------------------
# sandbox = Testmodus ohne echte Zahlungen (nur für Entwicklung/Tests)
# stripe  = Stripe Checkout + Subscriptions
# revolut = Revolut Merchant API
PAYMENT_PROVIDER=sandbox

# Stripe: Secret Key (sk_test_… / sk_live_…). Niemals clientseitig verwenden.
PAYMENT_PROVIDER_SECRET=
# Signing Secret des Webhook-Endpunkts (whsec_… bei Stripe)
PAYMENT_WEBHOOK_SECRET=
# Optional, ausschliesslich der öffentliche Schlüssel
STRIPE_PUBLISHABLE_KEY=

# --- Revolut Merchant / Business --------------------------------------------
# Secret Key der Merchant API – nur serverseitig verwenden
REVOLUT_MERCHANT_API_KEY=
# Öffentlicher Schlüssel (darf im Frontend erscheinen)
REVOLUT_PUBLIC_KEY=
# Konto-ID in Revolut Business (KEINE IBAN)
REVOLUT_ACCOUNT_ID=
# https://sandbox-merchant.revolut.com bzw. https://merchant.revolut.com
REVOLUT_API_BASE=https://sandbox-merchant.revolut.com
# https://sandbox-b2b.revolut.com/api/1.0 bzw. https://b2b.revolut.com/api/1.0
REVOLUT_BUSINESS_API_BASE=https://sandbox-b2b.revolut.com/api/1.0
# Access Token der Business API (nur READ-Rechte nötig)
REVOLUT_BUSINESS_ACCESS_TOKEN=
# Signing Secret der Revolut-Webhooks (wsk_…)
REVOLUT_WEBHOOK_SECRET=

# --- Unternehmens-/Rechnungsdaten -------------------------------------------
# Nicht gesetzte Felder werden in der Anwendung als CONFIGURE_ME markiert.
BUSINESS_NAME=CONFIGURE_ME
BUSINESS_ADDRESS=CONFIGURE_ME
BUSINESS_EMAIL=CONFIGURE_ME
SUPPORT_EMAIL=CONFIGURE_ME
TAX_ID=CONFIGURE_ME
VAT_ID=CONFIGURE_ME
# Steuersatz in Basispunkten: 1900 = 19,00 %, 0 = keine Ausweisung
INVOICE_TAX_RATE_BP=0
INVOICE_NUMBER_PREFIX=INV

# --- E-Mail ------------------------------------------------------------------
# log  = Versand wird nur protokolliert (Entwicklung)
# smtp = echter Versand über SMTP
MAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Music Creator Hub <no-reply@example.com>"

# --- Storage & Downloads -----------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# 512 MB
MAX_UPLOAD_BYTES=536870912
# Gültigkeit signierter Download-Links in Sekunden
DOWNLOAD_URL_TTL_SECONDS=300

# --- Betrieb -----------------------------------------------------------------
# Kulanzfrist nach fehlgeschlagener Zahlung (Tage)
GRACE_PERIOD_DAYS=3
# Nur für automatisierte Tests auf true setzen
RATE_LIMIT_DISABLED=false

# --- Optional: Seed ----------------------------------------------------------
# Legt beim Seed einen Admin an. Danach wieder entfernen.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
